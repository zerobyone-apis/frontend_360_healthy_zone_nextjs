{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "builds": [
      {
        "src": "next.config.js",
        "use": "@vercel/next"
      }
    ],
    "framework": "nextjs",
    "env": {
      "NODE_ENV": "production"
    },
    "build": {
      "env": {
        "NEXT_PRIVATE_STANDALONE": "true"
      }
    },
    "outputDirectory": ".next/standalone",
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/"
      }
    ]
  }
  